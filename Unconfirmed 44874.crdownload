"""#199a build: applies the CEO checklist to index.html at 2605ddc5. Every anchor must match exactly once."""
import sys, hashlib
import os; sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); from codec import decode, encode
SRC_IN, OUT = sys.argv[1], sys.argv[2]
W = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'src') + '/'
h = open(SRC_IN, encoding='utf-8').read()
assert hashlib.sha256(h.encode()).hexdigest().startswith('2605ddc5'), 'input is not 2605ddc5'
pre, src, post = decode(h)
def put(anchor, new, where='after'):
    global src
    n = src.count(anchor); assert n == 1, (anchor[:60], n)
    src = src.replace(anchor, anchor + new if where == 'after' else new + anchor)
method = open(W + 'ceoc_method.js').read()
tpl = open(W + 'ceoc_tpl.html').read()
card = open(W + 'ceoc_card.html').read()
more = '<sc-if value="{{ ceoc.hasMore }}"><div style="font-size: 12px; color: color-mix(in srgb, var(--color-text) 55%, transparent);">{{ ceoc.more }}</div></sc-if>'
dash_card = card.replace('KIND', 'today').replace('LIST', 'ceoc.top').replace('MORE', more)
ceo_card = card.replace('KIND', 'ceo').replace('LIST', 'ceoc.missed').replace('MORE', '')
# 1 state
put("view: 'dash', contactId: 1,", " ceoChecks: {}, ceocArea: '',")
# 2 title
put("const titleMap = this._titleMap = {", "\n      ceocheck: ['CEO checklist', '108 checks across 12 areas: measured, self-reported or blind, misses first'],")
# 3 nav (CEO group, alphabetical: before CEO reporting)
put("['ctorel', 'Build & release log', 'ph-git-branch', ''], ", "['ceocheck', 'CEO checklist', 'ph-list-checks', this._ceocVM(s).badge], ")
# 4 view flags + VM
put("isCeo: s.view === 'ceo' || s.view === 'cmdxceo',", "isCeocheck: s.view === 'ceocheck', ceoc: this._ceocVM(s),\n      ", where='before')
# 5 method (before _stKey)
put("\n  _stKey(s) {", method, where='before')
# 6 screen template
put('<sc-if value="{{ isDecisions }}">', tpl, where='before')
# 7 Today card: after the welcome card
i = src.index('<div class="card rb-welcome"'); assert src.count('<div class="card rb-welcome"') == 1
d, j = 0, i
import re
for m in re.finditer(r'<div\b|</div>', src[i:]):
    d += 1 if m.group(0) == '<div' else -1
    if d == 0: j = i + m.end(); break
src = src[:j] + dash_card + src[j:]
# 8 CEO reporting card (ceo and cmdxceo share isCeo)
k = src.index('<sc-if value="{{ isCeo }}">'); a = '<sc-for list="{{ ceo.five }}"'
p = src.index(a, k); assert src.count(a) == 1
src = src[:p] + ceo_card + '\n          ' + src[p:]
out = encode(pre, src, post)
open(OUT, 'w', encoding='utf-8').write(out)
print('built', OUT, len(out.encode()), hashlib.sha256(out.encode()).hexdigest())
