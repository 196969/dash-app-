"""Collects every screen key: titleMap keys plus every nav entry key in navSpec (own-books and client views)."""
import re, sys
import os; sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); from codec import decode
def views(path):
    pre, src, post = decode(open(path, encoding='utf-8').read())
    i = src.index('const titleMap = this._titleMap = {'); j = src.index('\n    };', i)
    tm = re.findall(r"\n\s*([A-Za-z0-9_]+): \[", src[i:j])
    k = src.index('const navSpec = '); l = src.index('const navGroups', k)
    nav = re.findall(r"\['([A-Za-z0-9_]+)', '[^']*', 'ph-", src[k:l])
    lit = re.findall(r"(?:s|this\.state)\.view === '([A-Za-z0-9_]+)'", src)
    out, seen = [], set()
    for v in tm + nav + lit:
        if v not in seen: seen.add(v); out.append(v)
    return out, len(tm), len(set(nav)), len(set(lit))
if __name__ == '__main__':
    v, a, b, c = views(sys.argv[1]); print(len(v), 'views |', a, 'titleMap |', b, 'nav |', c, 'view literals')
