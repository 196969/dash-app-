      scopeLine: 'The 11 areas are the People hub screens. Talent concentration (hrxtalentrisk) is not one of the 11 areas.',
      goOkr: () => this.go('okr')
    };
    this._hrokrFor = s0; this._hrokrVal = val;
    return val;
  }

