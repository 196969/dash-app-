  _hrokrVM(s0) {
    s0 = s0 || this.state || {};
    if (this._hrokrFor === s0 && this._hrokrVal) return this._hrokrVal;
    const s = s0;
    const A = x => Array.isArray(x) ? x : [];
    const fin = n => (typeof n === 'number' && isFinite(n)) ? n : 0;
    const N = x => fin(Number(x));
    const yr = Number(s.planYear) || new Date().getFullYear();
    const d0 = new Date(); d0.setHours(0, 0, 0, 0); const today = d0.getTime(); const DAY = 864e5;
    const pd = x => { const r = String(x || '').split('\u00b7')[0].replace(/^(week of|mon|tue|wed|thu|fri|sat|sun)[a-z]*\.?\s+/i, '').trim(); if (!r) return null; const t = Date.parse(/\d{4}/.test(r) ? r : r + ' ' + yr); return isFinite(t) ? t : null; };
    const T = x => String(x || '').trim();
    const of = (a, b) => a + ' of ' + b;
    const res = (st, basis, val) => ({ st, basis, val: val || '' });
    const met = (b, v) => res('met', b, v), miss = (b, v) => res('missed', b, v), open = (b, v) => res('open', b, v), dark = b => res('blind', b);
    const all = (k, n, b) => (n && k === n ? met : miss)(b, of(k, n));
    const people = A(s.people).filter(p => p && typeof p === 'object');
    const active = people.filter(p => p.status === 'Active');
    const planned = people.filter(p => p.status === 'Planned');
    const names = active.map(p => T(p.name));
    const ticks = (s.ceoChecks && typeof s.ceoChecks === 'object') ? s.ceoChecks : {};
    const areas = [
      ['hrxpeople', 'People & hiring', 'Keep the roster true', [
        ['m', 'Every Active person carries a role and a start date', 'people[].role, start', () => all(active.filter(p => T(p.role) && T(p.start)).length, active.length, 'Reads Dash: People, ' + active.length + ' Active')],
        ['m', 'Every planned seat states what has to be true before the hire', 'people[].start on Planned rows', () => planned.length ? all(planned.filter(p => T(p.start)).length, planned.length, 'Reads Dash: People, ' + planned.length + ' Planned seats') : open('Reads Dash: People, no Planned seats')],
        ['s', 'Write the hire-or-hold rule for the next seat']
      ]],
      ['hrxrecruit', 'Recruiting pipeline', 'Open a seat only on booked demand', [
        ['m', 'Every open req names its source', 'candidates[].source', () => { const C = A(s.candidates).filter(c => c && typeof c === 'object'); if (!C.length) return open('Reads Dash: Recruiting, no reqs open'); return all(C.filter(c => T(c.source)).length, C.length, 'Reads Dash: Recruiting, ' + C.length + ' reqs'); }],
        ['b', 'Time from req to hire', 'candidates[].stage', () => { const H = A(s.candidates).filter(c => c && c.stage === 'Hired'); return H.length ? open('Reads Dash: Recruiting, ' + H.length + ' Hired; time to hire needs dated stages') : dark('Blind until a req reaches Hired on Recruiting'); }]
      ]],
      ['hrxonboard', 'Onboarding & offboarding', 'Bring people on and off cleanly', [
        ['m', 'Onboarding steps complete for every hire in progress', 'hrOnboard[].steps', () => { const R = A(s.hrOnboard).filter(r => r && r.steps && typeof r.steps === 'object'); if (!R.length) return open('Reads Dash: Onboarding, nobody in progress'); const k = R.reduce((a, r) => a + Object.keys(r.steps).filter(x => r.steps[x]).length, 0), n = R.reduce((a, r) => a + Object.keys(r.steps).length, 0); return (k === n ? met : open)('Reads Dash: Onboarding, ' + R.length + ' planned hires, steps done across all', of(k, n)); }],
        ['m', 'No offboarding left open', 'hrOffboard', () => { const n = A(s.hrOffboard).length; return (n ? miss : met)('Reads Dash: Offboarding, ' + n + ' open', String(n)); }]
      ]],
      ['hrxcheckin', 'Check-ins & 1:1s', 'Keep the rhythm of check-ins', [
        ['m', 'A check-in submitted in the last 14 days', 'checkins[].submitted, week', () => { const C = A(s.checkins).filter(c => c && c.submitted).map(c => pd(c.week)).filter(t => t !== null).sort((a, b) => b - a); if (!C.length) return miss('Reads Dash: Check-ins, none submitted'); const d = Math.round((today - C[0]) / DAY); return (d <= 14 ? met : miss)('Reads Dash: Check-ins, last submitted ' + d + ' days ago', d + ' days'); }],
        ['m', 'Every 1:1 has a next meeting on the calendar', 'oneOnOnes[].next', () => { const O = A(s.oneOnOnes).filter(o => o && typeof o === 'object'); if (!O.length) return open('Reads Dash: 1:1s, none set'); return all(O.filter(o => { const t = pd(o.next); return t !== null && t >= today; }).length, O.length, 'Reads Dash: 1:1s, next date today or later'); }]
      ]],
      ['hrxengage', 'Engagement pulse', 'Know how the team feels', [
        ['b', 'The pulse holds or rises between readings', 'pulseHistory', () => { const P = A(s.pulseHistory).map(Number).filter(x => isFinite(x)); if (P.length < 2) return dark('Blind until two pulse readings are logged (' + P.length + ' so far)'); const a = P[P.length - 2], b = P[P.length - 1]; return (b >= a ? met : miss)('Reads Dash: Engagement pulse, last two readings', a + ' \u2192 ' + b); }],
        ['s', 'Ask the team one pulse question a month']
      ]],
      ['hrxdash', 'HR dashboard', 'Look after the people on the books', [
        ['m', 'Every Active person has benefits on file', 'empBenefits[].person', () => { const B = A(s.empBenefits).map(b => T(b && b.person)); return all(names.filter(n => B.indexOf(n) !== -1).length, names.length, 'Reads Dash: Benefits, matched by name to Active people'); }],
        ['m', 'Rest days planned this year', 'timeOff[].planned', () => { const n = A(s.timeOff).reduce((a, t) => a + N(t && t.planned), 0); return (n > 0 ? met : miss)('Reads Dash: Time off, days planned across all rows', String(n)); }]
      ]],
      ['hrxperf', 'Performance', 'Score against the written standard', [
        ['m', 'Every discipline carries a current score', 'perf.disciplines[].now', () => { const D = A((s.perf || {}).disciplines); if (!D.length) return dark('Blind until disciplines are set on Performance'); return all(D.filter(d => typeof d.now === 'number' && isFinite(d.now)).length, D.length, 'Reads Dash: Performance'); }],
        ['m', 'The weakest discipline rises', 'perf.disciplines[].now, prior', () => { const D = A((s.perf || {}).disciplines); if (!D.length) return dark('Blind until disciplines are scored on Performance'); const w = D.slice().sort((a, b) => N(a.now) - N(b.now))[0]; return (N(w.now) > N(w.prior) ? met : miss)('Reads Dash: Performance, weakest is ' + w.name, N(w.prior) + ' \u2192 ' + N(w.now)); }]
      ]],
      ['hrxreviews', 'Reviews', 'Finish every review in the cycle', [
        ['m', 'Every Active person has a finished self-review', 'reviewCycle[].who, self', () => { const R = A(s.reviewCycle).filter(r => r && names.indexOf(T(r.who)) !== -1); const k = R.filter(r => T(r.self) && !/^(drafted|not started)$/i.test(T(r.self))).length; return all(k, names.length, 'Reads Dash: Reviews, matched by name to Active people'); }],
        ['s', 'Hold the review conversation and write it down']
      ]],
      ['hrxgrowth', 'Growth & ladder', 'Move each person up a rung', [
        ['m', 'Growth-plan steps done by their due date', 'growth[].steps, due', () => { const G = A(s.growth).filter(g => g && Array.isArray(g.steps)); if (!G.length) return dark('Blind until a growth plan is written'); const k = G.reduce((a, g) => a + g.steps.filter(x => Array.isArray(x) && x[1]).length, 0), n = G.reduce((a, g) => a + g.steps.length, 0); const late = G.filter(g => { const t = pd(g.due); return t !== null && t < today && g.steps.some(x => !(Array.isArray(x) && x[1])); }).length; return (k === n ? met : late ? miss : open)('Reads Dash: Growth, ' + G.length + ' plans, ' + late + ' past due with steps open', of(k, n)); }],
        ['m', 'Every rung on the ladder carries a pay band', 'ladder[].band', () => { const L = A(s.ladder).filter(l => l && typeof l === 'object'); if (!L.length) return dark('Blind until the ladder is written'); return all(L.filter(l => T(l.band)).length, L.length, 'Reads Dash: Ladder'); }]
      ]],
      ['hrxtalent', 'Talent development', 'Build the bench behind the founder', [
        ['m', 'Every Active person finished a course', 'empLearning[].person, done', () => { const E = A(s.empLearning).filter(l => l && l.done).map(l => T(l.person)); return all(names.filter(n => E.indexOf(n) !== -1).length, names.length, 'Reads Dash: Talent development, matched by name'); }],
        ['m', 'Succession past stage 1', 'succession stage', () => { let S = null; try { S = this._successionStage(s); } catch (e) {} if (!S) return dark('Blind until the succession stage can be read'); return (S.stage >= 2 ? met : miss)('Reads Dash: succession stage, ' + S.name, S.stage + ' of 4'); }]
      ]],
      ['hrxswp', 'Workforce planning', 'Tie every seat to the plan', [
        ['m', 'Every planned seat has its pay written', 'people[].comp on Planned rows', () => planned.length ? all(planned.filter(p => T(p.comp)).length, planned.length, 'Reads Dash: People, Planned seats') : open('Reads Dash: People, no Planned seats')],
        ['s', 'Review the scenario-to-headcount read each quarter']
      ]]
    ];
    const ORDER = { missed: 0, open: 1, blind: 2, met: 3 };
    const TONE = { met: 'ok', missed: 'bad', open: 'warn', blind: 'idle' };
    const LABEL = { met: 'Met', missed: 'Missed', open: 'Open', blind: 'Blind' };
    const KIND = { m: 'Measured', s: 'Self-reported', b: 'Blind' };
    const tickTo = id => () => this.setState(st => { const cur = (st.ceoChecks && typeof st.ceoChecks === 'object') ? st.ceoChecks : {}; const nx = Object.assign({}, cur); if (nx[id]) delete nx[id]; else nx[id] = true; return { ceoChecks: nx }; });
    const rowsAll = [];
    const out = areas.map((ar, ai) => {
      const rows = ar[3].map((k, ki) => {
        const id = 'hr' + (ai + 1) + '.' + (ki + 1);
        let r;
        if (k[0] === 's') r = ticks[id] ? met('Self-reported \u00b7 ticked') : open('Self-reported \u00b7 Dash does not track this; tick when done');
        else { try { r = k[3](); } catch (e) { r = dark('Blind: this reading failed'); } }
        const kind = k[0] === 's' ? 's' : r.st === 'blind' ? 'b' : 'm';
        const st = r.st;
        const box = kind === 's' ? ('width: 18px; height: 18px; border-radius: 4px; flex: none; cursor: pointer; display: grid; place-items: center; font-size: 12px; background: transparent; border: 1.5px solid ' + (st === 'met' ? HUE.ok : 'color-mix(in srgb, var(--color-text) 40%, transparent)') + '; color: ' + HUE.ok + ';')
          : kind === 'b' ? 'width: 18px; height: 18px; border-radius: 4px; flex: none; background: transparent; border: 1.5px dashed color-mix(in srgb, var(--color-text) 30%, transparent);'
          : ('width: 18px; height: 18px; border-radius: 4px; flex: none; background: ' + HUE[TONE[st]] + ';');
        const row = { id, text: k[1], kind, kindLabel: KIND[kind], meta: kind === 's' ? r.basis : KIND[kind] + ' \u00b7 Source: ' + k[2] + ' \u00b7 ' + r.basis, basis: r.basis, st, label: LABEL[st], val: kind === 'm' ? r.val : '', hasVal: kind === 'm' && !!r.val,
          pillStyle: pill(TONE[st], LABEL[st]).style, box, mark: kind === 's' && st === 'met' ? '\u2713' : '', isSelf: kind === 's', notSelf: kind !== 's', tick: kind === 's' ? tickTo(id) : () => {},
          textStyle: 'font-size: 14px;' + (kind === 's' ? ' font-style: italic;' : ''), ord: ORDER[st] * 10 + ki,
          rowStyle: 'display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; padding: 9px 0; border-top: 1px solid var(--color-divider);' + (kind === 'b' ? ' opacity: 0.78;' : '') };
        rowsAll.push(row);
        return row;
      }).sort((a, b) => a.ord - b.ord);
      const m = rows.filter(x => x.st === 'met').length;
      return { key: ar[0], screen: ar[1], obj: ar[2], rows, score: m + ' of ' + rows.length + ' met', go: () => this.go(ar[0]),
        src: rows.filter(x => x.kind === 'm').length + ' measured \u00b7 ' + rows.filter(x => x.kind === 's').length + ' self-reported \u00b7 ' + rows.filter(x => x.kind === 'b').length + ' blind' };
    });
    const cnt = (k, v) => rowsAll.filter(x => x[k] === v).length;
    const okrs = A(s.okrs);
    const val = {
      areas: out, areaCount: String(out.length),
      headLine: out.length + ' HR objectives, ' + rowsAll.length + ' key results',
      kindLine: cnt('kind', 'm') + ' measured, ' + cnt('kind', 's') + ' self-reported, ' + cnt('kind', 'b') + ' blind',
      stateLine: cnt('st', 'met') + ' met \u00b7 ' + cnt('st', 'missed') + ' missed \u00b7 ' + cnt('st', 'open') + ' open \u00b7 ' + cnt('st', 'blind') + ' blind',
