"""Gate: size, SHA-256, codec round-trip and the 8 markers. Usage: gate.py <html> [expected-sha-prefix]"""
import sys, hashlib, re
import os; sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); from codec import decode, encode
p = sys.argv[1]; raw = open(p, 'rb').read(); h = raw.decode('utf-8')
sha = hashlib.sha256(raw).hexdigest(); print('file', p, len(raw), 'bytes', sha)
if len(sys.argv) > 2: assert sha.startswith(sys.argv[2]), 'SHA mismatch'
pre, src, post = decode(h); rt = encode(pre, src, post)
print('round-trip byte-identical:', rt == h); assert rt == h
M = {'wordmark': 1, 'portalhome': 1, 'webleads': 22, 'fndxcoverage': 10, '_lensBoardKeys': 10, '_lensWeights': 6, "view: 'dash'": 8}
for k, n in M.items(): c = src.count(k); print(f'  {k}: {c}', '' if c == n else f'(expected {n})'); assert c == n
for i in ('1004', '1005'):
    m = re.search(r"\{ id: '" + i + r"',[^}]*?status: '([^']+)'", src); print(f'  invoice {i}:', m.group(1)); assert m.group(1) == 'Paid'
print('GATE PASS')
