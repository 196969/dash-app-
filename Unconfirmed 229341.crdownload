#!/usr/bin/env python3
"""#199b edit set. build199b.py <afc48550 html> <out html> [edits.json]
Applies anchored edits to the decoded template; each anchor must match exactly once.
edits.json holds [old, new] pairs; reverse by swapping (apply in reverse order)."""
import json, sys, hashlib, os
D = os.path.join(os.path.dirname(os.path.abspath(__file__)), 'src')
rd = lambda f: open(os.path.join(D, f), encoding='utf-8').read()
OPEN = '<script type="__bundler/template">'
def decode(t):
    i = t.index(OPEN) + len(OPEN); j = t.index('</script>', i)
    b = t[i:j]; assert b.startswith('\n') and b.endswith('\n  ')
    return t[:i], json.loads(b[1:-3]), t[j:]
def encode(src): return '\n' + json.dumps(src, ensure_ascii=False).replace('</', '<\\u002F') + '\n  '

THR5 = 'Blind under 10 tagged hours \\u00b7 met at 40% Q2 or more, over all tagged hours, not a rolling week'
THR6 = 'Blind under 10 tagged hours \\u00b7 met at 3 or more Q2 entries of 90 minutes or longer in the last 7 days'
THR7 = 'Blind under 5 tagged decisions \\u00b7 met when the inside share over the last 30 days is at least the prior 30; blind with no prior window'
E = [
 # 1 titleMap entries
 ("      ceocheck: ['CEO checklist', ",
  "      timematrix: ['Time matrix', 'Every logged hour in one of four quadrants, with the Q2 share against a 40% target and the circle of influence on decisions'],\n"
  "      hrokr: ['HR OKRs', 'One HR objective per People screen, each key result measured from Dash, self-reported or blind'],\n"
  "      ceocheck: ['CEO checklist', "),
 # 2 People nav group
 ("['hrdash', 'HR dashboard', 'ph-chart-pie', ''], ",
  "['hrdash', 'HR dashboard', 'ph-chart-pie', ''], ['hrokr', 'HR OKRs', 'ph-target', ''], "),
 # 3 view flags and view models
 ("isCeocheck: s.view === 'ceocheck', ceoc: this._ceocVM(s),",
  "isCeocheck: s.view === 'ceocheck', ceoc: this._ceocVM(s),\n      isTimematrix: s.view === 'timematrix', tmx: s.view === 'timematrix' ? this._tmxVM(s) : null, isHrokr: s.view === 'hrokr', hrokr: s.view === 'hrokr' ? this._hrokrVM(s) : null,"),
 # 4 markup
 ('      <sc-if value="{{ isCeocheck }}">\n', None),
 # 5 calendar link
 ('      <sc-if value="{{ isCalendar }}">\n        <div style="display: flex; flex-direction: column; gap: var(--space-4);">\n',
  '      <sc-if value="{{ isCalendar }}">\n        <div style="display: flex; flex-direction: column; gap: var(--space-4);">\n'
  '          <div style="display: flex; align-items: center; gap: var(--space-2); flex-wrap: wrap; font-size: 13px;" data-tmx="calendar-link">Where the hours went: tag each one by quadrant. <button class="btn btn-secondary" sc-camel-on-click="{{ goTimematrix }}" style="font-size: 12px;"><i class="ph ph-squares-four"></i> Open the time matrix</button></div>\n'),
 ("isTimematrix: s.view === 'timematrix',", "isTimematrix: s.view === 'timematrix', goTimematrix: () => this.go('timematrix'),"),
 # 6 methods
 ('  _ceocVM(s0) {\n', None),
 # 7 checks 10.5-10.7
 ("        ['b', 'Spend 40% of the week on Q2 work', () => dark('Blind, waits on #199b (the time matrix): lights up when 10 hours carry a quadrant tag')],",
  "        ['m', 'Spend 40% of the week on Q2 work', () => { const C = this._tmxCore(s); const h = x => (Math.round(x * 10) / 10) + ' h'; if (C.taggedH < 10) return dark('Blind until 10 hours carry a quadrant tag on the Time matrix (' + h(C.taggedH) + ' so far)'); return (C.q2Share >= 0.4 ? met : miss)('Reads Dash: Time matrix, ' + h(C.by.q2.h) + ' of ' + h(C.taggedH) + ' tagged hours are Q2', Math.round(C.q2Share * 100) + '%'); }, '" + THR5 + "'],"),
 ("        ['b', 'Protect deep-work blocks', () => dark('Blind, waits on #199b (the time matrix): lights up when 10 hours carry a quadrant tag')],",
  "        ['m', 'Protect deep-work blocks', () => { const C = this._tmxCore(s); if (C.taggedH < 10) return dark('Blind until 10 hours carry a quadrant tag on the Time matrix (' + (Math.round(C.taggedH * 10) / 10) + ' h so far)'); const k = C.deep7.length; return (k >= 3 ? met : miss)('Reads Dash: Time matrix, ' + k + ' Q2 entr' + (k === 1 ? 'y' : 'ies') + ' of 90 minutes or longer in the last 7 days', String(k)); }, '" + THR6 + "'],"),
 ("        ['b', 'Decide inside the circle of influence', () => dark('Blind, waits on #199b: lights up when decisions carry the inside/outside-the-circle tag')],",
  "        ['m', 'Decide inside the circle of influence', () => { const C = this._tmxCore(s); if (C.dTag.length < 5) return dark('Blind until 5 decisions carry the circle tag on the Time matrix (' + C.dTag.length + ' so far)'); const a = C.last30, b = C.prior30; const P = x => Math.round(x * 100) + '%'; if (!a.n) return open('Reads Dash: Decision log, no tagged decisions in the last 30 days'); if (!b.n) return dark('Blind: no prior window to compare (no tagged decisions in the prior 30 days)'); return (a.share >= b.share ? met : miss)('Reads Dash: Decision log, inside the circle ' + a.inside + ' of ' + a.n + ' in the last 30 days against ' + b.inside + ' of ' + b.n + ' in the prior 30', P(a.share) + ' vs ' + P(b.share)); }, '" + THR7 + "'],"),
 # 8 threshold on the row
 ("all.push({ id, area: ar[0], text: c[1], kind, kindLabel: KIND[kind], st, label: LABEL[st], basis: r.basis,",
  "all.push({ id, area: ar[0], text: c[1], kind, kindLabel: KIND[kind], st, label: LABEL[st], basis: r.basis, thr: c[0] !== 's' && c[3] ? 'Threshold: ' + c[3] : '', hasThr: c[0] !== 's' && !!c[3],"),
 # 9 threshold on screen beside the check
 ('                      <span style="font-size: 12px; color: color-mix(in srgb, var(--color-text) 55%, transparent);">{{ c.basis }}</span>\n',
  '                      <span style="font-size: 12px; color: color-mix(in srgb, var(--color-text) 55%, transparent);">{{ c.basis }}</span>\n'
  '                      <sc-if value="{{ c.hasThr }}"><span style="font-size: 12px; color: color-mix(in srgb, var(--color-text) 70%, transparent);" data-thr="{{ c.id }}">{{ c.thr }}</span></sc-if>\n'),
]
def main():
    t = open(sys.argv[1], encoding='utf-8').read()
    head, src, tail = decode(t)
    applied = []
    for old, new in E:
        if new is None:
            if 'isCeocheck' in old: new = rd('tmx_hrokr_views.html') + old
            else: new = rd('tmx_methods.js') + rd('hrokr_methods.js') + old
        n = src.count(old)
        if n != 1: sys.exit('anchor matched %d times: %r' % (n, old[:90]))
        src = src.replace(old, new); applied.append([old, new])
    assert src.count('waits on #199b') == 0
    out = (head + encode(src) + tail).encode('utf-8')
    open(sys.argv[2], 'wb').write(out)
    if len(sys.argv) > 3: json.dump(applied, open(sys.argv[3], 'w', encoding='utf-8'), ensure_ascii=False, indent=1)
    print(len(applied), 'edits', len(out), 'bytes', hashlib.sha256(out).hexdigest())
main()
