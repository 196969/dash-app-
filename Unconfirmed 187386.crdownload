"""#199b checks: trial balance, council read, reduced motion, sideways scroll at 1440/480,
the three new surfaces, 10.5-10.7 lighting from UI tags, HR self-report tick round-trip, and shots.
Usage: check199b.py <html> [shot-dir]"""
import asyncio, sys, json, os, re

sys.path.insert(0, os.path.dirname(os.path.abspath(__file__)))
from dash import *
PATH = sys.argv[1]; OUT = (sys.argv[2] if len(sys.argv) > 2 else 'shots199b') + '/'
COUNCIL = ['fndxsuper', 'cmdxsuper', 'fndxhome', 'cncl', 'fndxcouncil', 'cmdxfounders', 'fndxfounders']
TXT = "()=>{const m=[...document.querySelectorAll('div.m-scroll')].pop(); return m?m.innerText:''}"
MOTION = """()=>{let n=0; for(const e of document.querySelectorAll('*')){const c=getComputedStyle(e); const an=c.animationName!=='none'&&parseFloat(c.animationDuration)>0&&c.animationPlayState==='running'; const tr=parseFloat(c.transitionDuration)>0; if(an) n++;} return n}"""
async def main():
    os.makedirs(OUT, exist_ok=True); rep = {}
    async with async_playwright() as p:
        for w, h in [(1440, 900), (480, 900)]:
            b = await p.chromium.launch(executable_path=CHROME)
            ctx = await b.new_context(viewport={'width': w, 'height': h}, reduced_motion='reduce')
            await ctx.add_init_script("try{localStorage.clear();localStorage.setItem('dash.tourDone','1')}catch(e){}")
            pg = await ctx.new_page(); errs = []
            pg.on('pageerror', lambda e: errs.append('PAGEERROR ' + str(e)[:200]))
            pg.on('console', lambda m: errs.append('CONSOLE ' + m.text[:200]) if m.type == 'error' else None)
            await pg.goto('file://' + os.path.abspath(PATH)); await pg.wait_for_timeout(4000); assert await pg.evaluate(FIND)
            r = {'tb': await pg.evaluate("()=>{const t=__dash.computeTB(__dash.state); return [t.debit,t.credit,t.tied]}")}
            for v in ['calendar', 'timematrix', 'hrokr', 'ceocheck', 'okr', 'dash']:
                await go(pg, v, 700)
                r[v] = await pg.evaluate("()=>({sx: document.documentElement.scrollWidth - innerWidth, nan: /\\bNaN\\b/.test(document.body.innerText), mustache: /\\{\\{[^}]*\\}\\}/.test(document.body.innerText)})")
                r[v]['moving'] = await pg.evaluate(MOTION)
                if v in ('calendar', 'timematrix', 'hrokr', 'ceocheck'): await pg.screenshot(path=f'{OUT}{w}_{v}.png', full_page=(v != 'calendar'))
            for v in COUNCIL:
                await go(pg, v, 700); t = await pg.evaluate(TXT)
                if re.search(r'\b\d+ of 40\b', t): r['council'] = {'view': v, 'of40': re.findall(r'\b\d+ of 40\b', t)[:3], 'pct': re.findall(r'\b\d+\.\d%', t)[:4], 'land': 'Land client two' in t}; break
            if w == 1440:
                await go(pg, 'timematrix', 600)
                for i in range(await pg.locator('button[title="Grow"]').count()): await pg.locator('button[title="Grow"]').nth(i).click()
                for i in range(5): await pg.locator('button:has-text("Inside")').nth(i).click()
                await pg.wait_for_timeout(400)
                r['lit'] = await pg.evaluate("()=>__dash._ceocVM(__dash.state).all.filter(x=>/^10\\.[567]$/.test(x.id)).map(x=>[x.id,x.kind,x.st,x.val])")
                r['tb_after_tags'] = await pg.evaluate("()=>{const t=__dash.computeTB(__dash.state); return [t.debit,t.credit]}")
                await go(pg, 'hrokr', 600)
                m0 = await pg.evaluate("()=>__dash._hrokrVM(__dash.state).stateLine")
                await pg.click('button[data-hk="hr1.3"]'); await pg.wait_for_timeout(300)
                m1 = await pg.evaluate("()=>[__dash._hrokrVM(__dash.state).stateLine, JSON.stringify(__dash.state.ceoChecks)]")
                await pg.click('button[data-hk="hr1.3"]'); await pg.wait_for_timeout(300)
                m2 = await pg.evaluate("()=>[__dash._hrokrVM(__dash.state).stateLine, JSON.stringify(__dash.state.ceoChecks)]")
                r['hrtick'] = [m0, m1, m2]; assert m2[0] == m0 and m2[1] == '{}'
            r['errors'] = errs; rep[w] = r; await b.close()
    print(json.dumps(rep, indent=0))
asyncio.run(main())
