"""Battery: opens every screen (views.py) in one session and records page errors, empty content, unrendered {{ }} and the header title.
Usage: sweep.py <html> <out.json>"""
import asyncio, json, sys
import os; sys.path.insert(0, os.path.dirname(os.path.abspath(__file__))); from dash import *; from views import views
PATH, OUT = sys.argv[1], sys.argv[2]
READ = r"""()=>{const m=[...document.querySelectorAll('div.m-scroll')].pop(); const t=m?m.innerText:''; const hub=m&&m.firstElementChild&&/since your last visit/.test(m.firstElementChild.innerText)?m.firstElementChild.innerText.length:0;
 const h=document.querySelector('header'); const title=h?h.innerText.split('\n')[0].trim().slice(0,80):'';
 return {len:t.length-hub, mustache:/\{\{[^}]*\}\}/.test(t), title, view:__dash.state.view}}"""
async def main():
    vs = views(PATH)[0]; res = {}
    async with async_playwright() as p:
        b, pg, errs = await open_app(p, PATH)
        for v in vs:
            n0 = len(errs)
            try:
                await pg.evaluate("v=>window.__dash.setState({view:v})", v); await pg.wait_for_timeout(220)
                r = await pg.evaluate(READ)
            except Exception as e:
                r = {'len': 0, 'mustache': False, 'title': '', 'view': None, 'exc': str(e)[:200]}
            r['errors'] = errs[n0:]; res[v] = r
        await b.close()
    json.dump(res, open(OUT, 'w'), indent=0)
    bad = {k: v for k, v in res.items() if v['errors'] or v.get('exc') or v['mustache'] or v['len'] < 40}
    print(PATH, len(res), 'screens;', len(bad), 'flagged:', list(bad)[:30])
asyncio.run(main())
