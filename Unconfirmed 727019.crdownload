"""Shared helpers for the Dash test harness (#199a). Locates the live component instance via the React fiber tree."""
import asyncio
from playwright.async_api import async_playwright
CHROME='/opt/pw-browsers/chromium-1194/chrome-linux/chrome'
FIND=r"""()=>{ if(window.__dash) return true; const D=window.DCLogic;
 for(const e of document.querySelectorAll('*')){ const k=Object.keys(e).find(k=>k.startsWith('__reactFiber$')); if(!k) continue; let f=e[k], n=0;
  while(f&&n<300){ const sn=f.stateNode; if(sn&&sn.logic&&(sn.logic instanceof D)){ window.__dash=sn.logic; return true; } f=f.return; n++; } }
 return false }"""
async def open_app(p, path, vw=1280, vh=900, fresh=True):
    b=await p.chromium.launch(executable_path=CHROME)
    ctx=await b.new_context(viewport={'width':vw,'height':vh})
    if fresh:
        await ctx.add_init_script("try{localStorage.clear();localStorage.setItem('dash.tourDone','1')}catch(e){}")
    pg=await ctx.new_page(); errs=[]
    pg.on('pageerror',lambda e:errs.append('PAGEERROR '+str(e)[:300]))
    pg.on('console',lambda m:errs.append('CONSOLE '+m.text[:300]) if m.type=='error' else None)
    import os; await pg.goto('file://'+os.path.abspath(path)); await pg.wait_for_timeout(4000)
    ok=await pg.evaluate(FIND)
    if not ok: raise SystemExit('component instance not found')
    return b,pg,errs
async def go(pg, view, wait=350):
    await pg.evaluate("v=>window.__dash.setState({view:v})", view); await pg.wait_for_timeout(wait)
