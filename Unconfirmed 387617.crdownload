    const founder = active.find(p => /founder|ceo|owner/i.test(String(p.role || '') + ' ' + String(p.type || ''))) || active[0] || null;
    const fFirst = founder ? String(founder.name || '').split(' ')[0] : '';
    const B = s.bkkp || {};
    const res = (st, basis, val) => ({ st, basis, val: val || '' });
