
  // ---- #199a: CEO checklist. 108 checks, 12 areas x 9. Kinds are derived from this list, never typed: 'm' measured (reads a Dash field), 's' self-reported (tick box), 'b' blind (names what would light it up). A measured check whose light-up condition is not met yet reports blind and the counts move with it. ----
  _ceocVM(s0) {
    s0 = s0 || this.state || {};
    if (this._ceocFor === s0 && this._ceocVal) return this._ceocVal;
    const s = (typeof this._exLive === 'function') ? this._exLive(s0) : s0;
    const A = x => Array.isArray(x) ? x : [];
