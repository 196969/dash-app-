        ['m', 'Collect fast, on clear terms', () => { const od = invs.filter(i => !done(i)).filter(i => { const t = pd(i.due); return t !== null && t < today; }); const noT = invs.filter(i => !String(i.terms || '').trim()).length; const ar = invs.filter(i => !done(i)).reduce((a, i) => a + N(i.amount) - rcv(i), 0); return (!od.length && !noT ? met : miss)('Reads Dash: open receivables ' + $(ar) + ', ' + od.length + ' past due, ' + noT + ' invoices without terms', od.length + ' past due'); }],
