    checks.forEach((ar, ai) => {
      ar[1].forEach((c, ci) => {
        const id = (ai + 1) + '.' + (ci + 1);
        let r;
        if (c[0] === 's') r = ticks[id] ? met('Self-reported \u00b7 ticked') : open('Self-reported \u00b7 tick when done');
        else { try { r = c[2](); } catch (e) { r = dark('Blind: this reading failed (' + String(e && e.message || e).slice(0, 60) + ')'); } }
        let kind = c[0] === 's' ? 's' : (c[0] === 'b' || r.st === 'blind') ? 'b' : 'm';
        if (r.st === 'blind') kind = 'b';
        const st = r.st;
        const box = kind === 's' ? ('width: 18px; height: 18px; border-radius: 4px; flex: none; cursor: pointer; display: grid; place-items: center; font-size: 12px; background: transparent; border: 1.5px solid ' + (st === 'met' ? HUE.ok : 'color-mix(in srgb, var(--color-text) 40%, transparent)') + '; color: ' + HUE.ok + ';')
          : kind === 'b' ? 'width: 18px; height: 18px; border-radius: 4px; flex: none; background: transparent; border: 1.5px dashed color-mix(in srgb, var(--color-text) 30%, transparent);'
          : ('width: 18px; height: 18px; border-radius: 4px; flex: none; background: ' + HUE[TONE[st]] + ';');
        all.push({ id, area: ar[0], text: c[1], kind, kindLabel: KIND[kind], st, label: LABEL[st], basis: r.basis, val: kind === 'm' ? r.val : '', hasVal: kind === 'm' && !!r.val,
          pillStyle: pill(TONE[st], LABEL[st]).style, box, mark: kind === 's' && st === 'met' ? '\u2713' : '', isSelf: kind === 's', notSelf: kind !== 's', tick: kind === 's' ? tickTo(id) : () => {}, ord: ORDER[st] * 1000 + ai * 10 + ci,
          rowStyle: 'display: flex; flex-wrap: wrap; gap: 6px 10px; align-items: center; padding: 9px 0; border-top: 1px solid var(--color-divider);' + (kind === 'b' ? ' opacity: 0.78;' : '') });
      });
    });
    const cnt = (k, v) => all.filter(x => x[k] === v).length;
    const counts = { measured: cnt('kind', 'm'), self: cnt('kind', 's'), blind: cnt('kind', 'b'), met: cnt('st', 'met'), missed: cnt('st', 'missed'), open: cnt('st', 'open'), dark: cnt('st', 'blind'), total: all.length };
    const missed = all.filter(x => x.st === 'missed');
    const sel = String(s0.ceocArea || '');
    const areas = checks.map((ar, ai) => {
      const rows = all.filter(x => x.area === ar[0]).sort((a, b) => a.ord - b.ord);
      const m = rows.filter(x => x.st === 'met').length, mi = rows.filter(x => x.st === 'missed').length;
      const tone = mi >= 4 ? 'bad' : mi >= 1 ? 'warn' : 'ok';
      const on = sel === ar[0];
      return { name: ar[0], rows, score: m + ' of ' + rows.length + ' met', note: mi ? mi + ' missed' : 'none missed', color: 'color: ' + HUE[tone] + '; font-family: var(--font-heading); font-size: 22px;',
        src: rows.filter(x => x.kind === 'm').length + ' measured \u00b7 ' + rows.filter(x => x.kind === 's').length + ' self-reported \u00b7 ' + rows.filter(x => x.kind === 'b').length + ' blind',
        show: !sel || on, pick: () => this.setState({ ceocArea: on ? '' : ar[0] }),
        cardStyle: 'cursor: pointer; text-align: left; gap: 4px; padding: 12px; font: inherit; color: inherit;' + (on ? ' outline: 2px solid var(--color-accent); outline-offset: -2px;' : '') };
    });
    const go = () => this.setState({ view: 'ceocheck' });
    const val = {
      areas, missed, hasMissed: missed.length > 0, noMissed: missed.length === 0, counts, all,
      kindLine: counts.measured + ' measured, ' + counts.self + ' self-reported, ' + counts.blind + ' blind',
      stateLine: counts.met + ' met \u00b7 ' + counts.missed + ' missed \u00b7 ' + counts.open + ' open \u00b7 ' + counts.dark + ' blind',
      missedTitle: counts.missed + ' missed check' + (counts.missed === 1 ? '' : 's'),
      top: missed.slice(0, 5), more: missed.length > 5 ? '+ ' + (missed.length - 5) + ' more on the checklist' : '', hasMore: missed.length > 5,
      filtered: !!sel, filterNote: sel ? 'Showing ' + sel + ' only' : '', clearFilter: () => this.setState({ ceocArea: '' }),
      bar: [['met', counts.met], ['missed', counts.missed], ['open', counts.open], ['blind', counts.dark]].map(x => ({ style: 'height: 100%; width: ' + (x[1] / Math.max(1, counts.total) * 100).toFixed(2) + '%; background: ' + HUE[TONE[x[0]]] + ';' })),
      go, badge: counts.missed ? String(counts.missed) : ''
    };
    this._ceocFor = s0; this._ceocVal = val;
    return val;
  }
