        ['m', 'Move succession past stage 1', () => { let S = null; try { S = this._successionStage(s); } catch (e) {} if (!S) return dark('Blind until the succession stage can be read'); return (S.stage >= 2 ? met : miss)('Reads Dash: succession stage ' + S.stage + ' of 4, ' + S.name, S.stage + ' of 4'); }],
        ['m', 'Pay the founder on a schedule', () => { const D = A(B.bkkpDraws).map(d => pd(d.date)).filter(t => t !== null); const months = new Set(D.map(t => { const d = new Date(t); return d.getFullYear() * 100 + d.getMonth(); })); const lm = new Date(today); lm.setDate(1); lm.setMonth(lm.getMonth() - 1); const ok = months.has(lm.getFullYear() * 100 + lm.getMonth()); return (ok ? met : miss)('Reads Dash: Bookkeeping \u00b7 Owner draw, ' + D.length + ' scheduled draws recorded' + (ok ? '' : ', none for last month'), D.length + ' draws'); }],
