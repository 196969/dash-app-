        ['m', 'Keep every journal entry balanced', () => { const J = A(B.journal); const bad = J.filter(j => { const L = A(j.lines); return Math.abs(L.reduce((a, l) => a + N(l.debit), 0) - L.reduce((a, l) => a + N(l.credit), 0)) >= 0.005; }); if (!J.length) return open('Reads Dash: Journal, no entries yet'); return (bad.length ? miss : met)('Reads Dash: Journal, ' + of(J.length - bad.length, J.length) + ' entries balance Dr = Cr', of(J.length - bad.length, J.length)); }],
        ['m', 'Lock each closed month', () => { const d = new Date(today); d.setDate(1); d.setMonth(d.getMonth() - 1); const key = MON[d.getMonth()] + ' ' + d.getFullYear(); const L = B.locked || {}; return (L[key] ? met : miss)('Reads Dash: Close & lock, ' + key + (L[key] ? ' is locked' : ' is not locked'), L[key] ? 'locked' : 'open'); }],
        ['m', 'Set a PIN on every seat', () => { const U = A(s.users); const no = U.filter(u => !String(u.pin || '').trim()).length; return (U.length && !no ? met : miss)('Reads Dash: Users & roles, ' + no + ' of ' + U.length + ' seats without a PIN', of(U.length - no, U.length)); }],
        ['m', 'Log every release', () => { const T = A(s.ctoReleases).map(r => pd(r.when)).filter(t => t !== null).sort((a, b) => b - a); return (T.length && within(T[0], 14) ? met : miss)('Reads Dash: Build & release log, latest release ' + fd(T.length ? T[0] : null), fd(T.length ? T[0] : null)); }]
      ]],
      ['Risk & Compliance', [
        ['m', 'File every compliance item before it\u2019s due', () => { const C = A(s.lglCompliance); const late = C.filter(c => !c.done && (() => { const t = pd(c.due); return t !== null && t < today; })()); const nx = C.filter(c => !c.done).map(c => [c, pd(c.due)]).filter(x => x[1] !== null).sort((a, b) => a[1] - b[1])[0]; return (late.length ? miss : met)('Reads Dash: Entity & compliance calendar, ' + late.length + ' items past due' + (nx ? '; next: ' + nx[0].item + ', ' + fd(nx[1]) : ''), late.length + ' late'); }],
        ['m', 'Protect the marks', () => { const I = A(s.lglIP); const nf = I.filter(x => /not filed/i.test(String(x.status || ''))).length; return (I.length && !nf ? met : miss)('Reads Dash: IP & trademark tracker, ' + nf + ' of ' + I.length + ' marks not filed', of(I.length - nf, I.length)); }],
