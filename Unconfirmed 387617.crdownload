    const of = (a, b) => a + ' of ' + b;
    const checks = [
      ['Strategic Direction', [
        ['m', 'Run the 90-day plan week by week', () => { const W = A(P.weeks); const t0 = pd(P.from); if (!W.length || t0 === null) return dark('Blind until the 90-day plan has dated weeks'); const wk = Math.floor((today - t0) / (7 * DAY)) + 1; if (wk < 1) return open('Reads Dash: the 90-day plan starts ' + fd(t0)); if (wk > W.length) return open('Reads Dash: the 90-day plan window closed ' + P.to + '; set the next one'); const w = W[wk - 1]; const n = A(w.acts).length; const d = A(w.acts).filter((a, i) => (s.planDone || {})[w.w + '-' + i]).length; return (d === n ? met : miss)('Reads Dash: 90-day plan, week ' + w.w + ' (' + w.dates + '), ' + of(d, n) + ' actions marked done', of(d, n)); }],
