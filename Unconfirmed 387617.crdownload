    const $ = n => (n < 0 ? '-$' : '$') + Math.abs(fin(n)).toFixed(2).replace(/\B(?=(\d{3})+(?!\d))/g, ',');
    const $0 = n => (n < 0 ? '-$' : '$') + Math.round(Math.abs(fin(n))).toLocaleString('en-US');
    const yr = Number(s.planYear) || new Date().getFullYear();
    const d0 = new Date(); d0.setHours(0, 0, 0, 0); const today = d0.getTime(); const DAY = 864e5;
    const pd = x => { const r = String(x || '').split('\u00b7')[0].replace(/^(week of|mon|tue|wed|thu|fri|sat|sun)[a-z]*\.?\s+/i, '').trim(); if (!r) return null; if (/^\d{4}-\d{2}-\d{2}$/.test(r)) { const t = Date.parse(r + 'T00:00:00'); return isFinite(t) ? t : null; } const t = Date.parse(/\d{4}/.test(r) ? r : r + ' ' + yr); return isFinite(t) ? t : null; };
    const within = (t, days) => t !== null && t <= today + DAY - 1 && t >= today - days * DAY;
    const MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']; const fd = t => { if (t === null || t === undefined) return 'no date'; const d = new Date(t); return d.getDate() + ' ' + MON[d.getMonth()] + ' ' + d.getFullYear(); };
    const ticks = (s0.ceoChecks && typeof s0.ceoChecks === 'object') ? s0.ceoChecks : {};
    const tb = (() => { try { return this.computeTB(s); } catch (e) { return null; } })();
    const effCash = tb ? fin(tb.effCash) : 0;
