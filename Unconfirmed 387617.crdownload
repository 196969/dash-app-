        ['m', 'Make 16 touches a week', () => { const n = A(s.hotlist).filter(h => within(pd(h.touch), 7)).length; return (n >= 16 ? met : miss)('Reads Dash: Hot List, ' + n + ' touches dated in the last 7 days against 16', n + ' of 16'); }],
        ['m', 'Work every tier-A prospect before tier B', () => { const a = A(s.hotlist).filter(h => h.tier === 'A'); const ns = a.filter(h => /not started/i.test(String(h.status || ''))).length; if (!a.length) return open('Reads Dash: Hot List, no tier-A prospects listed'); return (ns ? miss : met)('Reads Dash: Hot List, ' + ns + ' of ' + a.length + ' tier-A prospects not started', of(a.length - ns, a.length)); }],
        ['m', 'Deliver four free evaluations a month', () => { const n = A(s.estimates).filter(e => (e.state === 'estimate' || /free estimate|evaluation/i.test(String(e.status || ''))) && within(pd(e.sent), 30)).length; return (n >= 4 ? met : miss)('Reads Dash: Estimates, ' + n + ' free evaluations sent in the last 30 days against 4', n + ' of 4'); }],
        ['m', 'Turn half of evaluations into proposals', () => { const b = s.bdScore || {}; const e = N(b.evals), p = N(b.proposals); if (!e) return open('Reads Dash: BD scorecard, no evaluations yet'); const r = p / e; return (r >= 0.5 ? met : miss)('Reads Dash: BD scorecard, ' + p + ' proposals from ' + e + ' evaluations', Math.round(r * 100) + '%'); }],
        ['m', 'Know the proposal win rate', () => { const b = s.bdScore || {}; const p = N(b.proposals), w = N(b.wins); if (p < 3) return dark('Blind until 3 proposals are decided; BD scorecard shows ' + p + ' so far'); return met('Reads Dash: BD scorecard, ' + w + ' wins from ' + p + ' proposals', Math.round(w / p * 100) + '%'); }],
        ['m', 'Never price below the $1,500 floor', () => { const rows = invs.concat(A(s.estimates)).filter(r => N(r.amount) > 0); const lo = rows.filter(r => N(r.amount) < 1500); return (lo.length ? miss : met)('Reads Dash: ' + rows.length + ' invoices and estimates, ' + lo.length + ' priced under $1,500', lo.length ? lo.length + ' under' : 'none under'); }],
