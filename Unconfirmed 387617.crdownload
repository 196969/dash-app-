        ['m', 'Make revenue repeatable', () => { if (!collected) return open('Reads Dash: nothing collected yet'); const cnt = {}; paidInv.forEach(i => { const c = String(i.customer || ''); cnt[c] = (cnt[c] || 0) + 1; }); const rep = paidInv.filter(i => cnt[String(i.customer || '')] >= 2 || /retainer/i.test(String(i.type || ''))).reduce((a, i) => a + rcv(i), 0); return (rep > 0 ? met : miss)('Reads Dash: ' + $(rep) + ' of ' + $(collected) + ' collected came from repeat or retainer work', Math.round(rep / collected * 100) + '%'); }],
