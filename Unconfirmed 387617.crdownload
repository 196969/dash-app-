        ['m', 'Score your confidence in each objective', () => { const O = A(s.okrs); if (!O.length) return miss('Reads Dash: Objectives, none set'); const k = O.filter(o => typeof o.conf === 'number' && isFinite(o.conf)).length; return (k === O.length ? met : miss)('Reads Dash: Objectives, ' + of(k, O.length) + ' carry a confidence score', of(k, O.length)); }],
        ['m', 'Log every material decision with its reason', () => { const D = A(s.decisions); const recent = D.filter(d => within(pd(d.when), 30)); const noWhy = D.filter(d => !String(d.why || '').trim()).length; const last = D.map(d => pd(d.when)).filter(t => t !== null).sort((a, b) => b - a)[0]; return (recent.length && !noWhy ? met : miss)('Reads Dash: Decision log, ' + recent.length + ' logged in the last 30 days (latest ' + fd(last === undefined ? null : last) + ')' + (noWhy ? ', ' + noWhy + ' without a reason' : ''), recent.length + ' in 30 days'); }],
        ['m', 'Go back and grade old decisions against what happened', () => { const old = A(s.decisions).filter(d => { const t = pd(d.when); return t !== null && t < today - 30 * DAY; }); const ungraded = old.filter(d => !String(d.outcome || '').trim() || /^Open/i.test(String(d.outcome))); if (!old.length) return open('Reads Dash: Decision log, nothing older than 30 days yet'); return (ungraded.length ? miss : met)('Reads Dash: Decision log, ' + of(old.length - ungraded.length, old.length) + ' decisions older than 30 days have an outcome written', of(old.length - ungraded.length, old.length)); }],
        ['m', 'Keep revenue on pace for the target', () => { const t0 = pd(P.from), t1 = pd(P.to), T = N(P.target); if (t0 === null || t1 === null || !T) return dark('Blind until the 90-day plan carries a target and window'); const sh = Math.max(0, Math.min(1, (today - t0) / (t1 - t0))); const pace = T * sh; return (collected >= pace ? met : miss)('Reads Dash: ' + $(collected) + ' collected against ' + $0(pace) + ' pace on the ' + $0(T) + ' 90-day target (' + Math.round(sh * 100) + '% of the window gone)', $0(collected)); }],
